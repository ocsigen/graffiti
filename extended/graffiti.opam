# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Collaborative drawing application, from the Ocsigen tutorial"
authors: ["graffiti authors"]
depends: [
  "dune" {>= "3.17"}
  "ocsigen-dune-rules"
  "eliom" {>= "13.0" & < "14.0"}
  "ocsigen-ppx-rpc" {>= "2.0~" & < "3.0"}
  "ocsipersist-sqlite-config" {>= "3.1" & < "4.0"}
  "ocsigen-toolkit" {>= "5.0" & < "6.0"}
  "cairo2"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
