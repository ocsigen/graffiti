(lang dune 3.17)

(using directory-targets 0.1)

(name graffiti)

(authors "graffiti authors")

(package
 (name graffiti)
 (synopsis "Collaborative drawing application, from the Ocsigen tutorial")
 (depends
  ocsigen-dune-rules
  (eliom
   (and
    (>= 13.0)
    (< 14.0)))
  (ocsigen-ppx-rpc
   (and
    (>= 2.0~)
    (< 3.0)))
  (ocsipersist-sqlite-config
   (and
    (>= 3.1)
    (< 4.0)))
  (ocsigen-toolkit
   (and
    (>= 5.0)
    (< 6.0)))
  cairo2))

(dialect
 (name "eliom-server")
 (implementation
  (extension "eliom"))
 (interface
  (extension "eliomi")))

(formatting
 (enabled_for ocaml "eliom-server"))

(generate_opam_files true)
